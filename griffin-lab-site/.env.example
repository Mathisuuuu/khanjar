# Copie ce fichier en .env.local puis renseigne les valeurs.

# Jeton secret pour la page /moderation (changer le statut d'une proposition).
# Choisis une longue chaîne aléatoire et ne la partage pas.
ADMIN_TOKEN=change-moi

# Base PostgreSQL. Obligatoire en production.
# Laisse vide en développement : base embarquée dans data/pglite, rien à installer.
DATABASE_URL=

# ── Comptes (Auth.js) ─────────────────────────────────────────────
# Secret qui signe les sessions. Génère-le avec : npx auth secret
AUTH_SECRET=change-moi

# Chaque fournisseur n'apparaît actif que si ses deux valeurs sont définies.
# URL de retour à déclarer chez le fournisseur : <ton-site>/api/auth/callback/<discord|google>
# Discord : https://discord.com/developers/applications → OAuth2
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Google : https://console.cloud.google.com/apis/credentials → ID client OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Envoi des e-mails de confirmation d’inscription (SMTP : Brevo, OVH, Mailjet…).
# En développement, laisse vide : l’e-mail s’affiche dans la console du serveur.
SMTP_URL=
MAIL_FROM="Fleija <no-reply@ton-domaine.fr>"

# Lien d'invitation affiché sur le rond Discord de l'en-tête
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/c2e9nSH8pV

# Administrateurs : e-mails (séparés par des virgules) de comptes e-mail + mot de passe.
# Espace /admin (comptes, bannissements, groupes), modération sans jeton.
ADMIN_EMAILS=

# Recherches : e-mails (séparés par des virgules) des membres de l'équipe
# (rôle Équipe, qui peut aussi être donné depuis /admin). L'équipe, les admins
# et le super admin écrivent dans tous les papiers « Recherches Fleija ».
RESEARCH_TEAM_EMAILS=

# Adresse publique du site (liens des e-mails, retour de la liaison Discord).
# En production : https://ton-domaine (sans / final).
AUTH_URL=http://localhost:3000

# Jeton du bot Discord (annonces #research / #strategy-ideas, photos de profil).
# Facultatif : sans lui, le site fonctionne sans rien envoyer à Discord.
# En production il est dans /etc/griffin-discord.env, jamais dans ce fichier.
DISCORD_BOT_TOKEN=
